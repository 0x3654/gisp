# syntax=docker/dockerfile:1.6
# Образ cross-encoder реранкера (BAAI/bge-reranker-v2-m3, 568M params).
# По умолчанию запускается с PyTorch CPU runtime; при наличии model.onnx можно переключиться
# через env RERANKER_BACKEND=onnx-fp32. ONNX-экспорт оставлен отдельной задачей —
# при первой сборке скачиваем только safetensors-веса.

# ===================================
# BUILDER STAGE
# ===================================
FROM python:3.12-slim AS builder

ARG VERSION=1.0

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    gcc \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /venv

# Базовый стек. torch + transformers + tokenizers — runtime для PyTorch-CPU бекенда.
# onnxruntime ставим тоже, чтобы при появлении model.onnx можно было переключиться без пересборки.
RUN /venv/bin/pip install --no-cache-dir \
    "huggingface_hub>=0.24,<1.0" \
    "transformers==4.48.0" \
    "tokenizers>=0.20" \
    "torch>=2.3,<3" \
    "sentencepiece>=0.2,<1" \
    "onnxruntime==1.23.2"

RUN /venv/bin/pip install --no-cache-dir \
    fastapi==0.115.6 \
    "uvicorn[standard]==0.34.0" \
    psycopg2==2.9.10 \
    "numpy<2.0" \
    "pydantic>=2.6,<3"

# ===================================
# MODEL DOWNLOADER STAGE
# Только snapshot_download (никакого ONNX-экспорта в build-time).
# ===================================
FROM python:3.12-slim AS model-downloader

ARG HF_TOKEN
ARG HF_REPO_ID="BAAI/bge-reranker-v2-m3"
ARG HF_ENDPOINT="https://huggingface.co"

ENV HF_REPO_ID=${HF_REPO_ID} \
    HF_ENDPOINT=${HF_ENDPOINT} \
    MODEL_DIR=/models

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir "huggingface_hub>=0.24,<1.0"

RUN --mount=type=secret,id=hf_token,target=/tmp/hf_token \
    python - <<'PY' && rm -rf /root/.cache /tmp/*
import os
from pathlib import Path
from huggingface_hub import snapshot_download

repo_id = os.environ["HF_REPO_ID"]
target  = Path(os.environ.get("MODEL_DIR", "/models"))

token_file = Path("/tmp/hf_token")
token = (token_file.read_text().strip() or None) if token_file.is_file() else os.getenv("HF_TOKEN")
endpoint = os.environ.get("HF_ENDPOINT") or None

snapshot_download(
    repo_id=repo_id,
    local_dir=str(target),
    allow_patterns=[
        "config.json",
        "tokenizer.json",
        "tokenizer_config.json",
        "special_tokens_map.json",
        "sentencepiece.bpe.model",
        "model.safetensors",
    ],
    token=token,
    endpoint=endpoint,
)
PY

# ===================================
# FINAL STAGE
# ===================================
FROM python:3.12-slim

ARG VERSION=1.0
LABEL maintainer="0x3654"
LABEL service="gisp_reranker"
LABEL version=$VERSION
LABEL org.opencontainers.image.source="https://github.com/0x3654/gisp"

ENV TZ=Europe/Moscow \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/venv/bin:$PATH" \
    RERANKER_MODEL_DIR=/app/model \
    RERANKER_BACKEND=pytorch-cpu \
    RERANKER_CACHE_TTL_SECONDS=86400

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 10001 appuser \
    && useradd -u 10001 -g appuser -s /sbin/nologin -d /app appuser

COPY --from=builder /venv /venv
COPY --from=model-downloader --chown=appuser:appuser /models /app/model
COPY --chown=appuser:appuser ./src/reranker /app

EXPOSE 8020

HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD python -c "import socket, os; s=socket.socket(); s.connect(('127.0.0.1', int(os.getenv('RERANKER_PORT','8020')))); s.close()"

USER appuser

CMD ["uvicorn", "reranker_service:app", "--host", "0.0.0.0", "--port", "8020"]
