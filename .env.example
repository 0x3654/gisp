BOT_TOKEN={{ gisp_telegram_bot_token }}
CHAT_ID={{ gisp_telegram_chat_id }}
# Registry settings
REGISTRY_NODE_NAME={{ inventory_hostname }}

# PostgreSQL
POSTGRES_HOST=postgres_registry
POSTGRES_PORT={{ postgres_port }}
POSTGRES_USER={{ gisp_pg_user }}
POSTGRES_PASSWORD={{ gisp_pg_password }}
POSTGRES_DB={{ gisp_pg_db }}
PGDATA={{ pg_data }}
TZ={{ timezone }}
PG_AUTOPREWARM_INTERVAL={{ pg_autoprewarm_interval }}

# API service
REESTR_MIN_LIMIT={{ reestr_min_limit }}
REESTR_DEFAULT_LIMIT={{ reestr_default_limit }}
REESTR_MAX_LIMIT={{ reestr_max_limit }}
REESTR_MIN_OFFSET={{ reestr_min_offset }}
REESTR_DEFAULT_OFFSET={{ reestr_default_offset }}

# Semantic service
SEMANTIC_URL=http://semantic:{{ semantic_port }}/semantic_normalize
SEMANTIC_BATCH_URL=http://semantic:{{ semantic_port }}/batch_semantic_normalize
SEMANTIC_CACHE_TTL_SECONDS={{ semantic_cache_ttl_seconds }}
SEMANTIC_FORCE_SEQSCAN={{ semantic_force_seqscan }}

# Hybrid search (/reestr/hybrid) — RRF pgvector + FTS(ru) + pg_trgm
RRF_K=60
RRF_WEIGHT_VEC=1.0
RRF_WEIGHT_FTS=1.2
RRF_WEIGHT_TRGM=1.2
HYBRID_TOPK_PER_CHANNEL=100
HYBRID_DEFAULT_LIMIT=50
HYBRID_TRGM_THRESHOLD=0.15

# Cross-encoder reranker (BAAI/bge-reranker-v2-m3), профиль 'rerank'
RERANKER_URL=http://reranker:8020/rerank
RERANKER_PORT=8020
RERANKER_BACKEND=pytorch-cpu
RERANKER_MAX_LEN=512
RERANKER_MAX_PAIRS=50
RERANKER_WORKERS=1
RERANKER_TIMEOUT=15
RERANKER_CACHE_TTL_SECONDS=86400
RERANK_BEFORE_LIMIT=50

# Reasoning agent (matcher), профиль 'matcher'
MATCHER_PORT=8030
REASONER_PROVIDER=local
REASONER_MODEL=qwen3-32b
REASONER_API_BASE=
REASONER_API_KEY=
REASONER_TIMEOUT=60
REASONER_MAX_ITERATIONS=5
REASONER_MAX_TOOL_CALLS=10
REASONER_CONFIDENCE_THRESHOLD=0.7
REASONER_TOKEN_BUDGET=32000
REASONER_ESCALATION_MODEL=claude-sonnet-4-6
REASONER_ESCALATION_API_KEY=
ANTHROPIC_API_KEY=

# Migrations runner (профиль 'migrations', run-once)
MIGRATION_FILES=051_hybrid_backfill.sql
MIGRATION_BATCH_SIZE=10000
MIGRATION_ONLY_MISSING=1
MIGRATION_SKIP_BACKFILL=0
MIGRATION_SKIP_INDEXES=0

# Import
FILES_DIR={{ files_dir }}
START_DATE={{ start_date }}
BASE_URL={{ base_url }}
LOG_DIR={{ log_dir }}
MAX_CSV_FILES={{ max_csv_files }}
MAX_LOG_FILES={{ max_log_files }}
AUTO_EMBED={{ auto_embed }}
STARTER_FORCE={{ starter_force }}

# Downloader
DOWNLOAD_METHOD={{ download_method }}
DOWNLOADER_SSH_HOST={{ downloader_ssh_host | default('') }}
DOWNLOADER_SSH_PORT={{ downloader_ssh_port | default('22') }}
DOWNLOADER_SSH_USER={{ downloader_ssh_user | default('') }}
DOWNLOADER_SSH_KEY_B64={{ gisp_downloader_ssh_key_b64 | default('') }}

# Docker compose infrastructure
POSTGRES_PORT={{ postgres_port }}
API_PORT={{ api_port }}
SEMANTIC_PORT={{ semantic_port }}
OPENWEBUI_PORT={{ openwebui_port }}
PG_SHM_SIZE={{ pg_shm_size }}
SEMANTIC_WORKERS={{ semantic_workers }}
STARTER_MAX_WAIT={{ starter_max_wait }}

# Embeddings worker
EMBEDDINGS_BATCH_SIZE={{ embeddings_batch_size }}
EMBEDDINGS_SHARD_INDEX={{ embeddings_shard_index }}
EMBEDDINGS_SHARD_COUNT={{ embeddings_shard_count }}

# Worker flags
FORCE={{ force }}
DRY_RUN={{ dry_run }}
SOURCE_FILES={{ source_files }}
EMBED_IDS={{ embed_ids }}
LIMIT={{ limit }}
EXTRA_EMBED_ARGS={{ extra_embed_args }}
SEMANTIC_URL_OVERRIDE={{ semantic_url_override }}
